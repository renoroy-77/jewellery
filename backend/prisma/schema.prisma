datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  Shipped
  Delivered
  Cancelled
  Returned
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  name         String    @default("Chief Sthapati")
  role         String    @default("SUPERADMIN")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

model Category {
  id          String   @id
  slug        String   @unique
  name        String
  tamilName   String?
  image       String
  itemCount   Int      @default(0)
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id                  String   @id @default(uuid())
  slug                String   @unique
  name                String
  deity               String
  category            String
  price               Float
  originalPrice       Float?
  rating              Float    @default(5.0)
  reviewsCount        Int      @default(1)
  inStock             Boolean  @default(true)
  featured            Boolean  @default(false)
  description         String   @db.Text
  metalGold           String   @default("2.5%")
  metalSilver         String   @default("12.5%")
  metalCopper         String   @default("65.0%")
  metalZinc           String   @default("15.0%")
  metalIron           String   @default("5.0%")
  purityCertificate   String   @default("Government Assay Certified")
  dimensions          String?
  weight              String?
  consecrationDetails String?
  images              String[]
  benefits            String[]
  tags                String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("products")
}

model Order {
  id               String       @id
  devoteeId        String?
  devotee          DevoteeUser? @relation(fields: [devoteeId], references: [id], onDelete: SetNull)
  devoteeName      String
  email            String
  phone            String
  items            Json
  subtotal         Float?
  shippingFee      Float?
  referralCodeUsed String?
  referralDiscount Float?   @default(0)
  walletDiscount   Float?   @default(0)
  totalAmount      Float
  status           OrderStatus @default(Pending)
  shippingAddress  String   @db.Text
  date             String
  trackingNumber   String?
  paymentMethod    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([devoteeId])
  @@map("orders")
}

model DevoteeUser {
  id              String           @id
  name            String
  email           String           @unique
  phone           String
  shippingAddress String           @db.Text
  memberSince     String
  referralCode    String?          @unique
  referredBy         String?
  walletBalance      Float               @default(0.0)
  addresses          DevoteeAddress[]
  orders             Order[]
  walletTransactions WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("devotee_users")
}

model DevoteeAddress {
  id            String      @id @default(uuid())
  devoteeId     String
  devotee       DevoteeUser @relation(fields: [devoteeId], references: [id], onDelete: Cascade)
  label         String      @default("Home") // "Home", "Puja Room", "Ancestral Illam", "Temple"
  recipientName String
  phone         String
  streetAddress String      @db.Text
  city          String
  state         String      @default("Tamil Nadu")
  pincode       String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([devoteeId])
  @@map("devotee_addresses")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_verifications")
}

model BlogPost {
  id         String   @id
  slug       String   @unique
  title      String
  subtitle   String
  excerpt    String   @db.Text
  image      String
  date       String
  readTime   String
  tag        String
  category   String
  authorName String
  authorRole String
  likes      Int      @default(0)
  featured   Boolean  @default(false)
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("blog_posts")
}

model HeroSlide {
  id          Int      @id @default(autoincrement())
  kicker      String
  titleLine1  String
  titleLine2  String
  subtitle    String
  ctaText     String   @default("Shop Now")
  ctaLink     String   @default("/collections")
  tag         String   @default("FAITH IN EVERY DETAIL")
  image       String
  mobileImage String
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

model StoryBanner {
  id         String   @id @default(uuid())
  title      String
  desc       String
  ctaText    String   @default("Explore")
  ctaLink    String   @default("/collections")
  image      String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("story_banners")
}

model Announcement {
  id               String   @id @default(uuid())
  freeShippingText String   @default("Free Shipping on Orders Above ₹999")
  authenticityText String   @default("Authentic Panchaloham")
  worldwideText    String   @default("Blessings Delivered Worldwide")
  activePromoAlert String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("announcements")
}

model Faq {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String   @default("general")
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("faqs")
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  @@map("media_assets")
}

model ReferralSettings {
  id                    String   @id @default("default")
  enabled               Boolean  @default(true)
  refereeDiscountRupees Float    @default(50.0) // Discount for friend on first order (e.g. ₹50)
  referrerRewardRupees  Float    @default(100.0) // Store credit wallet reward for referrer upon delivery (e.g. ₹100)
  minOrderSubtotal      Float    @default(500.0) // Min order subtotal for referral discount
  updatedAt             DateTime @updatedAt

  @@map("referral_settings")
}

model Referral {
  id                   String   @id @default(uuid())
  referrerId           String
  refereeEmail         String
  refereePhone         String?
  orderId              String   @unique
  status               String   @default("PENDING") // PENDING, DELIVERED (rewarded), CANCELLED
  rewardAmount         Float    @default(100.0)
  rewardType           String   @default("WALLET_CREDIT") // WALLET_CREDIT or COUPON
  rewardCoupon         String?  // legacy single-use coupon if applicable
  rewardCouponUsed     Boolean  @default(false)
  walletCredited       Boolean  @default(false) // true when referrer wallet balance is credited on delivery
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("referrals")
}

model WalletTransaction {
  id           String      @id @default(uuid())
  devoteeId    String
  devotee      DevoteeUser @relation(fields: [devoteeId], references: [id], onDelete: Cascade)
  amount       Float       // Positive for credit, negative for debit
  type         String      // REFERRAL_REWARD, ORDER_REDEMPTION, ORDER_CANCEL_REFUND, CLAWBACK
  referenceId  String?
  description  String?
  balanceAfter Float
  createdAt    DateTime    @default(now())

  @@unique([type, referenceId])
  @@index([devoteeId])
  @@map("wallet_transactions")
}
